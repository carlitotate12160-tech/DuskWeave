# Default file profile is Linux-only; supply an absolute protected-file path.
DW_DATABASE_CONFIG_MODE=file
DW_DATABASE_URL_FILE=
# DW_DATABASE_URL must be absent in file mode, even when empty.
# For Windows/Linux M0 development select env-local, omit DW_DATABASE_URL_FILE,
# and supply DW_DATABASE_URL through the authorized local environment.
# DW_DATABASE_URL=
# Test-only variables: restricted runtime DSN and fixture-setup admin DSN.
DW_TEST_DATABASE_URL=
DW_TEST_ADMIN_DATABASE_URL=
